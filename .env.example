# Copy this file to .env and edit it.

# Your time zone (recordings are named by local time), e.g. Europe/London, America/New_York, Asia/Kolkata
TZ=UTC

# Dashboard port on this computer: http://localhost:8085
CCTV_PORT=8085

# Optional: create the admin account on first start. Leave the password empty
# and the dashboard asks you to create the account the first time you open it.
CCTV_ADMIN_USER=admin
CCTV_ADMIN_PASSWORD=

# Where settings and recordings are kept on this computer.
# Windows example: CCTV_RECORDINGS_DIR=D:/CCTV
CCTV_CONFIG_DIR=./data/config
CCTV_RECORDINGS_DIR=./data/recordings
