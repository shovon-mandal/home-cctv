# =====================================================================
#  Home CCTV settings  ->  /etc/cctv/cctv.conf   (Docker: data/config/cctv.conf)
#  Most of these can be changed in the dashboard. After editing by hand run:
#  sudo cctv-apply   (Docker: docker compose restart)
# =====================================================================

[general]
# Name shown in the dashboard title (also editable in Settings -> System)
site_name = Home CCTV
# Dashboard: http://<this-computer-IP>:8085
web_port = 8085

# --- Storage -----------------------------------------------------------
# Recordings folder size limit when no SSD is used (on a single-board computer this is
# the SD card; in Docker it is the recordings folder)
sd_buffer_gb = 7
# Always keep at least this much free space on that disk for other programs
sd_min_free_gb = 2

# Linux only: a USB SSD/disk plugged in is mounted automatically and recordings go to
# its "CCTV" folder. Your other files are never touched. Unplug only after: sudo cctv-ssd-eject
ssd_auto = yes
# Size limit of the CCTV folder on the SSD (oldest clips are deleted first)
ssd_max_gb = 200
# Keep at least this % of the SSD free (only CCTV clips are deleted for it)
ssd_min_free_percent = 5

# Recording is cut into 1-minute files (safe if the power goes). Once a quarter hour is
# finished, its minutes are joined into ONE file of this many minutes (0 = keep 1-minute files).
merge_minutes = 15
# Join only on the SSD (no = also on the SD card / in Docker)
merge_ssd_only = yes

# --- Google Drive (optional; connect it in Settings -> Google Drive) ----
drive_enabled = yes
drive_remote = gdrive:CCTV
# Also upload when an SSD is connected? (yes/no)
drive_backup_when_ssd = yes
# How long clips stay on Drive, and the maximum size (a free account has 15 GB)
drive_keep_days = 5
drive_max_gb = 12
# Upload speed limit, e.g. 1M = 1 MB/s  (0 = no limit)
drive_bwlimit = 0

# --- Motion detection (runs on the low-quality stream, little CPU) ----
motion_width = 640
motion_height = 360
# seconds without motion before an event ends
event_gap = 20
pre_capture_sec = 3
post_capture_sec = 5
# long motion is uploaded in pieces of this many minutes
max_clip_minutes = 3

# Cameras: dashboard -> Settings -> Cameras  (or cameras.conf)
