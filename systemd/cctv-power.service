[Unit]
Description=CCTV: keep the board's power draw steady (CPU speed limit)
# after Armbian's own CPU settings, which would otherwise undo the limit
After=sysinit.target cpufrequtils.service loadcpufreq.service armbian-hardware-optimize.service

[Service]
Type=oneshot
ExecStart=/opt/cctv/bin/cctv-power

[Install]
WantedBy=multi-user.target
