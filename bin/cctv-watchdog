#!/usr/bin/env python3
"""
cctv-watchdog – restart go2rtc if any enabled stream has been silent too long.

Checks go2rtc's /api/streams endpoint. Each stream has a "producers" list; each
producer has a "url" and optionally "recv" (bytes received). If a producer has been
connected but recv hasn't changed for STALE_SECS, we restart go2rtc so it
reconnects.

Run every 2 minutes via cctv-watchdog.timer.
"""
import json, subprocess, sys, time, urllib.request, urllib.error
from pathlib import Path

GO2RTC_API   = "http://127.0.0.1:1984"
STATE_FILE   = Path("/run/cctv/watchdog-state.json")
STALE_SECS   = 60   # restart if a stream had no new bytes for this long
RESTART_WAIT = 10   # seconds between restarts (don't flap)

def api_get(path):
    try:
        with urllib.request.urlopen(GO2RTC_API + path, timeout=5) as r:
            return json.loads(r.read())
    except Exception:
        return None

def load_state():
    try:
        return json.loads(STATE_FILE.read_text())
    except Exception:
        return {}

def save_state(s):
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(s))

def go2rtc_running():
    r = subprocess.run(["systemctl", "is-active", "--quiet", "cctv-go2rtc"])
    return r.returncode == 0

def restart_go2rtc(reason):
    print(f"[watchdog] restarting go2rtc: {reason}", flush=True)
    subprocess.run(["systemctl", "restart", "cctv-go2rtc"])
    time.sleep(RESTART_WAIT)

def main():
    if not go2rtc_running():
        print("[watchdog] go2rtc not running, skipping", flush=True)
        return

    streams = api_get("/api/streams")
    if streams is None:
        print("[watchdog] could not reach go2rtc API", flush=True)
        return

    now    = time.time()
    state  = load_state()
    stale  = []

    for name, info in streams.items():
        producers = info.get("producers") or []
        for p in producers:
            recv = p.get("recv", 0)
            key  = f"{name}|{p.get('url','')[:60]}"
            prev = state.get(key)

            if prev is None:
                # first time we see this producer
                state[key] = {"recv": recv, "t": now}
            elif recv > prev["recv"]:
                # bytes are flowing – update
                state[key] = {"recv": recv, "t": now}
            else:
                # recv has not changed since last check
                silent = now - prev["t"]
                if silent >= STALE_SECS:
                    stale.append(f"{name} silent {int(silent)}s")

    save_state(state)

    if stale:
        restart_go2rtc("; ".join(stale))
        # clear state so we start fresh after restart
        save_state({})
    else:
        print(f"[watchdog] ok – {len(streams)} streams, all active", flush=True)

if __name__ == "__main__":
    main()
