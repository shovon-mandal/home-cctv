#!/usr/bin/env python3
"""
cctv-watchdog - restart go2rtc when a camera stream is connected but frozen.

Some cameras (seen on Imou/Dahua firmware) stop sending RTSP data without
closing the TCP connection. go2rtc then waits forever and recordings stop.

Every run (cctv-watchdog.timer, every 2 minutes) this reads go2rtc's
/api/streams. For every producer that has a live connection it remembers
`bytes_recv`. If the same connection has not received a single byte for
STALE_SECS while something is consuming the stream, go2rtc is restarted.
Producers without a connection (camera offline, nobody watching) are ignored,
and restarts are rate limited so an unreachable camera can't cause a loop.
"""
import json
import os
import subprocess
import sys
import time
import urllib.request

sys.path.insert(0, "/opt/cctv/lib")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import cctvsvc  # noqa: E402

API = os.environ.get("GO2RTC_API", "http://127.0.0.1:1984")
STATE_FILE = os.environ.get("CCTV_WATCHDOG_STATE", "/run/cctv/watchdog.json")
STALE_SECS = 60          # no new bytes for this long -> frozen
MIN_GAP = 300            # at most one restart per 5 minutes


def streams():
    with urllib.request.urlopen(API + "/api/streams", timeout=5) as r:
        return json.loads(r.read() or b"{}") or {}


def load():
    try:
        with open(STATE_FILE) as f:
            return json.load(f)
    except Exception:
        return {}


def save(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(state, f)
    os.replace(tmp, STATE_FILE)


def restart(reason):
    print(f"restarting go2rtc: {reason}", flush=True)
    cmd = os.environ.get("CCTV_GO2RTC_RESTART")    # used by the tests
    if cmd:
        subprocess.call(cmd, shell=True)
    else:
        cctvsvc.control("restart", "cctv-go2rtc")


def main():
    try:
        data = streams()
    except Exception as e:
        print(f"go2rtc API not reachable ({e}); nothing to do", flush=True)
        return 0

    now = time.time()
    old = load()
    seen, stale = {}, []
    for name, info in data.items():
        info = info or {}
        if not info.get("consumers"):
            continue                      # nobody is reading: go2rtc closes it anyway
        for p in info.get("producers") or []:
            if not p.get("format_name"):  # no live connection (offline / connecting)
                continue
            key = f"{name}#{p.get('id', 0)}"
            recv = int(p.get("bytes_recv", 0))
            prev = old.get("conns", {}).get(key)
            if prev and recv <= prev["recv"]:
                seen[key] = prev          # keep the time of the last progress
                if now - prev["t"] >= STALE_SECS:
                    stale.append(f"{name} frozen {int(now - prev['t'])}s")
            else:
                seen[key] = {"recv": recv, "t": now}

    last = float(old.get("last_restart", 0))
    if stale and now - last >= MIN_GAP:
        restart(", ".join(stale))
        save({"conns": {}, "last_restart": now})
    else:
        if stale:
            print("frozen but restarted recently, waiting: " + ", ".join(stale), flush=True)
        save({"conns": seen, "last_restart": last})
    return 0


if __name__ == "__main__":
    sys.exit(main())
