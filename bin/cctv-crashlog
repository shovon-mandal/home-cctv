#!/usr/bin/env python3
"""Black box for sudden shutdowns: writes kernel messages, warnings and a heartbeat
(temperature, load, CPU speed, memory) to the SD card every few seconds, synced at once,
so after an unexpected switch-off the last seconds before it can be read:

    cctv-crashlog          -> the end of the log from before the last restart
    cctv-crashlog --all    -> list of saved logs

Armbian keeps its normal logs in RAM, which is why they are empty after a power cut.
Files: /var/lib/cctv/crashlog (the last 6 runs, at most ~2 MB each).
"""
import glob
import os
import subprocess
import sys
import threading
import time

DIR = os.environ.get("CCTV_CRASHLOG", "/var/lib/cctv/crashlog")
MAX = 2 * 1024 * 1024


def read(p, default=""):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return default


def show():
    olds = sorted(glob.glob(os.path.join(DIR, "previous-*.log")))
    if "--all" in sys.argv:
        for p in olds + [os.path.join(DIR, "current.log")]:
            if os.path.exists(p):
                print(f"{os.path.getsize(p):>9}  {p}")
        return
    if not olds:
        return print("No log from an earlier run yet.")
    p = olds[-1]
    print(f"== last lines before the restart ({os.path.basename(p)}) ==")
    with open(p, errors="replace") as f:
        print("".join(f.readlines()[-45:]), end="")


def main():
    os.makedirs(DIR, exist_ok=True)
    cur = os.path.join(DIR, "current.log")
    if os.path.exists(cur):
        os.replace(cur, os.path.join(DIR, time.strftime("previous-%Y%m%d-%H%M%S.log")))
    for p in sorted(glob.glob(os.path.join(DIR, "previous-*.log")))[:-6]:
        os.remove(p)
    out = open(cur, "a", buffering=1, errors="replace")
    lock = threading.Lock()

    def write(line):
        with lock:
            if out.tell() > MAX:                # keep the end: start the file again
                out.seek(0)
                out.truncate()
            out.write(time.strftime("%H:%M:%S ") + line.rstrip() + "\n")
            out.flush()
            os.fsync(out.fileno())

    def follow(cmd, tag):
        while True:
            try:
                p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
                for line in p.stdout:
                    write(f"[{tag}] {line}")
            except OSError as e:
                write(f"[{tag}] cannot read: {e}")
            time.sleep(5)

    write("== start ==")
    threading.Thread(target=follow, args=(["dmesg", "-w", "-T", "--level", "emerg,alert,crit,err,warn,notice"], "kernel"),
                     daemon=True).start()
    threading.Thread(target=follow, args=(["journalctl", "-f", "-n", "0", "-p", "warning", "-o", "short"], "log"),
                     daemon=True).start()
    while True:
        temps = [int(t) // 1000 for t in (read(p, "0") for p in glob.glob("/sys/class/thermal/thermal_zone*/temp")) if t.isdigit()]
        mhz = int(read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq", "0") or 0) // 1000
        mem = {ln.split(":")[0]: ln.split()[1] for ln in read("/proc/meminfo").splitlines() if ":" in ln}
        write(f"beat temp={max(temps) if temps else '?'}C load={read('/proc/loadavg').split(' ')[0]} "
              f"cpu={mhz}MHz free_mb={int(mem.get('MemAvailable', 0)) // 1024}")
        time.sleep(5)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--run":
        main()
    else:
        show()
