#!/usr/bin/env python3
"""Docker health check: healthy when the dashboard answers (any HTTP status)."""
import os
import sys
import urllib.error
import urllib.request

port = os.environ.get("CCTV_WEB_PORT", "8085")
try:
    urllib.request.urlopen(f"http://127.0.0.1:{port}/api/me", timeout=8)
except urllib.error.HTTPError:
    pass                      # 401 = server is up, just not logged in
except Exception as e:  # noqa: BLE001
    print(f"dashboard not answering: {e}")
    sys.exit(1)
