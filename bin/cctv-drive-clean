#!/usr/bin/env python3
"""Keep Google Drive under control: delete clips older than drive_keep_days,
then delete oldest clips until the CCTV folder is below drive_max_gb.
Runs every 15 minutes as user cctv.

Deleting is permanent (not to Google Drive's trash: trashed files still count against
the Google account's storage, and filled it up). Clips this system had put in the trash
earlier are removed for good too - only files of the CCTV folder, nothing else.
When an upload found the Google account full, 2 GB more than usual are freed."""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.environ.get("CCTV_LIB", "/opt/cctv/lib"))
import cctvconf  # noqa: E402

RCLONE_CONF = os.environ.get("RCLONE_CONF", "/etc/cctv/rclone.conf")


def rclone(*args, capture=False):
    cmd = ["rclone", "--config", RCLONE_CONF, "--drive-use-trash=false", *args]
    if capture:
        return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout
    return subprocess.call(cmd)


def remote_type(remote):
    try:
        dump = json.loads(rclone("config", "dump", capture=True) or "{}")
        return dump.get(remote.split(":", 1)[0], {}).get("type", "")
    except (subprocess.CalledProcessError, ValueError, OSError):
        return ""


def main():
    g, _ = cctvconf.load()
    configured = os.path.exists(RCLONE_CONF) and os.path.getsize(RCLONE_CONF) > 0
    if not cctvconf.yes(g["drive_enabled"]) or not configured:
        return 0
    remote = g["drive_remote"]
    keep = int(float(g["drive_keep_days"]))
    cap = int(float(g["drive_max_gb"]) * 1024 ** 3)

    run = os.environ.get("CCTV_RUN", "/run/cctv")
    full_flag = os.path.join(run, "drive-full")
    # clips that earlier versions moved to the trash: delete them for good (CCTV folder only).
    # Only on a real Google Drive remote: other storage types ignore --drive-trashed-only,
    # and there this would delete everything.
    if remote_type(remote) == "drive":
        rclone("delete", remote, "--drive-trashed-only")
        rclone("rmdirs", remote, "--drive-trashed-only", "--leave-root")
    rclone("delete", remote, "--min-age", f"{keep}d")

    files = json.loads(rclone("lsjson", "-R", "--files-only", remote, capture=True) or "[]")
    files.sort(key=lambda f: f.get("ModTime", ""))
    total = sum(f.get("Size", 0) for f in files)
    if os.path.exists(full_flag):               # the Google account is full: make extra room
        # 2 GB more than usual, but never below half the set size: if other files fill
        # the account, the clips must not all go
        cap = max(min(cap, total - 2 * 1024 ** 3), cap // 2)
        try:
            os.remove(full_flag)
        except OSError:
            pass
    removed = 0
    for f in files:
        if total <= cap:
            break
        if rclone("deletefile", f"{remote.rstrip('/')}/{f['Path']}") == 0:
            total -= f.get("Size", 0)
            removed += 1
    rclone("rmdirs", remote, "--leave-root")
    per_cam = {}
    for f in files:
        if f["Path"].endswith(".mp4"):
            per_cam[f["Path"].split("/")[0]] = per_cam.get(f["Path"].split("/")[0], 0) + 1
    try:
        with open(os.path.join(run, "drive-usage.json.tmp"), "w") as fh:
            json.dump({"bytes": total, "cap": cap, "clips": sum(per_cam.values()), "per_cam": per_cam,
                       "keep_days": keep, "time": int(__import__("time").time())}, fh)
        os.replace(os.path.join(run, "drive-usage.json.tmp"), os.path.join(run, "drive-usage.json"))
    except OSError:
        pass
    print(f"drive: {total / 1024 ** 3:.2f} GB used, {removed} old clip(s) removed for space")
    return 0


if __name__ == "__main__":
    sys.exit(main())
