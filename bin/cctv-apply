#!/usr/bin/env python3
"""Generate go2rtc / Motion / web configs from /etc/cctv/cctv.conf + cameras.conf
and restart services.

Usage: sudo cctv-apply [--no-restart] [--auto]
  --auto   used by the dashboard (cctv-apply.path): does not restart the web server
"""
import json
import os
import time
import subprocess
import sys

sys.path.insert(0, "/opt/cctv/lib")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import cctvconf  # noqa: E402

OUT = os.environ.get("CCTV_GEN_DIR", "/etc/cctv/generated")
RUN = os.environ.get("CCTV_RUN", "/run/cctv")
FRAMERATE = 5  # motion-detection frame rate (sub stream); recordings keep the camera's own fps


def yq(s):
    """YAML single-quoted string."""
    return "'" + str(s).replace("'", "''") + "'"


def write(path, text, mode=0o640):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def gen_go2rtc(cams):
    lines = [
        "# AUTO-GENERATED by cctv-apply. Edit /etc/cctv/cameras.conf or the dashboard instead.",
        "api:",
        "  listen: '127.0.0.1:1984'",
        "rtsp:",
        "  listen: '127.0.0.1:8554'",
        "webrtc:",
        "  listen: '127.0.0.1:8555'",
        "log:",
        "  level: warn",
        "streams:",
    ]
    for c in cams:
        if not c["enabled"]:
            continue
        for name, url in ((c["id"], c["main_url"]), (c["id"] + "_sub", c["sub_url"])):
            lines += [f"  {name}:", f"    - {yq(url)}"]
            if c["audio"]:
                # browsers can't play the camera's G.711 audio: go2rtc makes AAC,
                # but only while someone is actually listening
                lines.append(f"    - {yq('ffmpeg:' + name + '#audio=aac')}")
    return "\n".join(lines) + "\n"


def gen_motion(g, cams, outdir):
    """Motion only DETECTS (on the small sub stream) and logs events; ffmpeg does the recording."""
    main = [
        "# AUTO-GENERATED by cctv-apply. Edit /etc/cctv/cameras.conf or the dashboard instead.",
        "daemon off",
        "setup_mode off",
        "log_level 5",
        "target_dir /srv/cctv/rec",
        "webcontrol_port 0",
        "stream_port 0",
        "picture_output first",            # one snapshot when motion starts (timeline thumbnail)
        "picture_quality 70",
        "snapshot_interval 0",
        "movie_output off",
        f"framerate {FRAMERATE}",
        f"width {g['motion_width']}",
        f"height {g['motion_height']}",
        f"event_gap {g['event_gap']}",
        "minimum_motion_frames 2",
        "noise_tune on",
        "despeckle_filter EedDl",
        # a light switching on/off IS an event we want, so don't filter it out
        "lightswitch_percent 0",
        # draw a red box around what moved on the event snapshot
        "locate_motion_mode on",
        "locate_motion_style redbox",
        "",
    ]
    files = []
    for c in cams:
        if not c["enabled"] or c["mode"] == "off":
            continue
        n = int(c["id"][3:])
        conf = [
            f"camera_id {n}",
            f"camera_name {c['name']}",
            # Motion reads from the local go2rtc restream, so each camera gets
            # only one connection per stream no matter how many viewers.
            f"netcam_url rtsp://127.0.0.1:8554/{c['id']}_sub",
            f"threshold {int(c['threshold'])}",
            f"picture_filename {c['id']}/%Y-%m-%d/m-%H-%M-%S",
            f"on_event_start /opt/cctv/bin/cctv-event start {n}",
            f"on_event_end /opt/cctv/bin/cctv-event end {n} {g['event_gap']}",
            f"on_picture_save /opt/cctv/bin/cctv-event pic {n} %f",
        ]
        p = os.path.join(outdir, f"motion-{c['id']}.conf")
        write(p, "\n".join(conf) + "\n")
        files.append(p)
        main.append(f"camera {p}")
    if not files:
        main.append("# no cameras with recording enabled")
    return "\n".join(main) + "\n", bool(files)


def gen_recorders(cams, outdir):
    """recorder.json for cctv-recorder (it reloads by itself when this changes)."""
    rec = []
    for c in cams:
        if not c["enabled"] or c["mode"] == "off":
            continue
        stream = c["id"] if c["record_stream"] == "main" else c["id"] + "_sub"
        rec.append({"id": c["id"], "src": f"rtsp://127.0.0.1:8554/{stream}", "record": True, "audio": c["audio"]})
    write(os.path.join(outdir, "recorder.json"), json.dumps(rec, indent=1), 0o644)
    return [r["id"] for r in rec]


def report(ok, msg):
    try:
        os.makedirs(RUN, exist_ok=True)
        with open(os.path.join(RUN, "apply.json"), "w", encoding="utf-8") as f:
            json.dump({"ok": ok, "message": msg, "time": int(time.time())}, f, ensure_ascii=False)
    except OSError:
        pass


MIGRATE_FLAG = os.path.join(os.path.dirname(cctvconf.CAMS_PATH), ".v3-migrated")


def migrate():
    """v3: recording became 24/7 + motion marks. Old cameras set to "motion" would now lose
    every minute where detection missed something, so move them to 24/7 once, and use the
    new, more sensitive default threshold."""
    if os.path.exists(MIGRATE_FLAG) or not os.path.exists(cctvconf.CAMS_PATH):
        return
    try:
        import configparser
        cp = configparser.ConfigParser(interpolation=None)
        cp.optionxform = str.lower
        cp.read(cctvconf.CAMS_PATH, encoding="utf-8")
        cams = []
        for sec in cp.sections():
            d = dict(cp.items(sec))
            d["id"] = sec
            if d.get("mode", "motion") == "motion":
                d["mode"] = "continuous"
            if d.get("threshold", "1500") == "1500":
                d["threshold"] = "400"
            cams.append(d)
        cctvconf.save_cameras(cams)
        open(MIGRATE_FLAG, "w").close()
        print("Migrated cameras to 24/7 recording with higher motion sensitivity")
    except Exception as e:  # noqa: BLE001
        print(f"migration skipped: {e}")


def migrate_v4():
    """v4: more sensitive default (400 -> 250) for cameras still on the old default."""
    flag = os.path.join(os.path.dirname(cctvconf.CAMS_PATH), ".v4-migrated")
    if os.path.exists(flag) or not os.path.exists(cctvconf.CAMS_PATH):
        return
    try:
        import configparser
        cp = configparser.ConfigParser(interpolation=None)
        cp.optionxform = str.lower
        cp.read(cctvconf.CAMS_PATH, encoding="utf-8")
        cams = []
        for sec in cp.sections():
            d = dict(cp.items(sec))
            d["id"] = sec
            if d.get("threshold") in ("400", "1500"):
                d["threshold"] = "250"
            cams.append(d)
        cctvconf.save_cameras(cams)
        open(flag, "w").close()
    except Exception as e:  # noqa: BLE001
        print(f"migration v4 skipped: {e}")


def main():
    restart = "--no-restart" not in sys.argv
    auto = "--auto" in sys.argv
    migrate()
    migrate_v4()
    for f in (cctvconf.CAMS_PATH, cctvconf.CONF_PATH):
        if os.path.exists(f):
            cctvconf.fix_owner(f)
    try:
        g, cams = cctvconf.load()
    except Exception as e:  # noqa: BLE001
        print(f"Config error: {e}", file=sys.stderr)
        report(False, f"Config error: {e}")
        return 1

    os.makedirs(OUT, exist_ok=True)
    write(os.path.join(OUT, "go2rtc.yaml"), gen_go2rtc(cams))
    motion_conf, has_rec = gen_motion(g, cams, OUT)
    write(os.path.join(OUT, "motion.conf"), motion_conf)
    rec_ids = gen_recorders(cams, OUT)
    # Public camera list for the web UI: names only, never URLs or passwords.
    public = [{"id": c["id"], "name": c["name"], "mode": c["mode"], "ptz": c["ptz"]} for c in cams if c["enabled"]]
    write(os.path.join(OUT, "cameras.json"), json.dumps(public, ensure_ascii=False, indent=1), 0o644)

    try:
        import pwd, grp  # noqa: E401
        uid, gid = pwd.getpwnam("cctv").pw_uid, grp.getgrnam("cctv").gr_gid
        for f in os.listdir(OUT):
            os.chown(os.path.join(OUT, f), uid, gid)
        os.chown(OUT, uid, gid)
    except (KeyError, PermissionError):
        pass

    print(f"OK: {len([c for c in cams if c['enabled']])} camera(s) configured")
    for c in cams:
        state = "ON " if c["enabled"] else "OFF"
        print(f"  [{state}] {c['id']}: {c['name']}  (recording: {c['mode'] if c['enabled'] else '-'})")

    if restart:
        units = ["cctv-go2rtc"] if auto else ["cctv-go2rtc", "cctv-web"]
        subprocess.call(["systemctl", "restart", *units])
        if has_rec:
            subprocess.call(["systemctl", "restart", "cctv-motion"])
        else:
            subprocess.call(["systemctl", "stop", "cctv-motion"])
        subprocess.call(["systemctl", "start", "cctv-recorder"])   # it reloads recorder.json by itself
        print("Services restarted.")
    n = len([c for c in cams if c['enabled']])
    report(True, f"{n} camera(s) active || {n}টা camera চালু")
    return 0


def run_auto():
    """Dashboard-triggered: re-run if another change arrived while we were working."""
    req = os.path.join(RUN, "apply-request")
    for _ in range(5):
        started = time.time()
        rc = main()
        try:
            if os.path.getmtime(req) <= started:
                return rc
        except OSError:
            return rc
    return rc


if __name__ == "__main__":
    sys.exit(run_auto() if "--auto" in sys.argv else main())
