#!/bin/bash
# Choose the portable SSD for recordings.
#
#   sudo cctv-ssd-setup                  -> list USB disks/partitions
#   sudo cctv-ssd-setup /dev/sda1        -> use it AS IS: your files stay, recordings go
#                                           into a "CCTV-Recordings" folder   (recommended)
#   sudo cctv-ssd-setup --format /dev/sda -> ERASE the whole disk and make it ext4
set -eu
eval "$(/opt/cctv/bin/cctv-config)"
SSD_ENV=/etc/cctv/ssd.env
MNT=/mnt/cctv-ssd
FOLDER=CCTV-Recordings
mkdir -p /run/cctv "$MNT"

list() {
  echo "USB disks and partitions:"
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINT,TRAN -e 7 | awk 'NR==1 || /usb/ || /^[^a-z]*sd/'
  echo
  echo "Use it and KEEP your files (recommended):  sudo cctv-ssd-setup /dev/sdXN   (e.g. /dev/sda1)"
  echo "Erase everything and format:              sudo cctv-ssd-setup --format /dev/sdX"
}

rootdisk() { echo "/dev/$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" | head -1)"; }

finish() {  # $1 = partition
  local part=$1 uuid fstype u g
  uuid=$(blkid -o value -s UUID "$part" || true)
  fstype=$(blkid -o value -s TYPE "$part" || true)
  [ -n "$uuid" ] || { echo "No UUID found: $part"; exit 1; }
  printf 'SSD_UUID=%s\nSSD_FSTYPE=%s\n' "$uuid" "$fstype" > "$SSD_ENV"
  chmod 644 "$SSD_ENV"
  rm -f /run/cctv/ejected
  umount -l "$MNT" 2>/dev/null || true
  # let cctv-storage mount it with the right options
  /opt/cctv/bin/cctv-storage
  if ! mountpoint -q "$MNT"; then
    echo "Mount failed. Filesystem: $fstype"
    echo "exFAT: sudo apt install exfatprogs   |   NTFS: sudo apt install ntfs-3g"
    exit 1
  fi
  mkdir -p "$MNT/$FOLDER"
  touch "$MNT/$FOLDER/.cctv-ssd"
  chown -R cctv:cctv "$MNT/$FOLDER" 2>/dev/null || true
  /opt/cctv/bin/cctv-storage
  echo
  df -h "$MNT" | tail -1 | awk '{print "SSD: size " $2 ", free " $4}'
  echo "Recording folder: $FOLDER  (max ${CFG_SSD_MAX_GB} GB, change ssd_max_gb in /etc/cctv/cctv.conf)"
  echo "Done. Recordings now go to the SSD.  Before unplugging:  sudo cctv-ssd-eject"
}

[ $# -ge 1 ] || { list; exit 0; }

if [ "$1" = "--format" ]; then
  DISK=${2:-}
  [ -b "$DISK" ] || { echo "Give a disk, e.g.: sudo cctv-ssd-setup --format /dev/sda"; exit 1; }
  [ "$DISK" != "$(rootdisk)" ] || { echo "That is the system disk, cancelled."; exit 1; }
  lsblk -o NAME,SIZE,FSTYPE,LABEL "$DISK"
  echo
  echo "!!! ALL DATA ON $DISK WILL BE ERASED !!!"
  read -r -p "Type ERASE to continue: " ans
  [ "$ans" = "ERASE" ] || { echo "Cancelled."; exit 1; }
  touch /run/cctv/ejected
  umount -l "$MNT" 2>/dev/null || true
  for p in $(lsblk -lnpo NAME "$DISK" | tail -n +2); do umount -l "$p" 2>/dev/null || true; done
  wipefs -a "$DISK"
  parted -s "$DISK" mklabel gpt mkpart cctv ext4 1MiB 100%
  sleep 2
  PART=$(lsblk -lnpo NAME "$DISK" | tail -n 1)
  mkfs.ext4 -F -L CCTV_SSD -m 0 "$PART"
  finish "$PART"
  exit 0
fi

PART=$1
[ -b "$PART" ] || { echo "Not found: $PART"; list; exit 1; }
[ "$PART" != "$(rootdisk)" ] && [ "$(lsblk -no PKNAME "$PART")" != "$(basename "$(rootdisk)")" ] \
  || { echo "That is the system disk, cancelled."; exit 1; }
# whole disk given: use its only partition
if [ "$(lsblk -no TYPE "$PART" | head -1)" = "disk" ]; then
  parts=$(lsblk -lnpo NAME,TYPE "$PART" | awk '$2=="part"{print $1}')
  if [ "$(echo "$parts" | grep -c .)" = 1 ]; then
    PART=$parts; echo "Partition: $PART"
  else
    echo "This disk has several partitions, give the one to use:"; lsblk "$PART"; exit 1
  fi
fi
FST=$(blkid -o value -s TYPE "$PART" || true)
case "$FST" in
  ext4|ext3|ext2|xfs|btrfs|exfat|ntfs) ;;
  vfat) echo "Warning: FAT32 cannot hold files over 4 GB (clips are 2 minutes, so this is fine)." ;;
  "") echo "This partition has no filesystem. To format: sudo cctv-ssd-setup --format /dev/sdX"; exit 1 ;;
  *) echo "Unknown filesystem '$FST'."; exit 1 ;;
esac
echo "Filesystem: $FST — your files stay; only a '$FOLDER' folder is created."
finish "$PART"
