#!/usr/bin/env python3
"""Every minute (user cctv):
 1. cameras in "motion" mode: delete finished segments without motion (after a few minutes)
 2. upload every finished segment that overlaps a motion event (plus its motion snapshot)
    to Google Drive, once each. Even the smallest motion counts.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta

sys.path.insert(0, "/opt/cctv/lib")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import cctvconf  # noqa: E402
import cctvrec  # noqa: E402

RUN = os.environ.get("CCTV_RUN", "/run/cctv")
REC = os.environ.get("CCTV_REC", "/srv/cctv/rec")
RCLONE_CONF = os.environ.get("RCLONE_CONF", "/etc/cctv/rclone.conf")
STATE = os.environ.get("CCTV_UPLOADED", "/srv/cctv/uploaded.txt")


LOG = os.path.join(os.path.dirname(STATE), "upload-log.json")   # recent uploads, survives reboots
INFO = {}                                                         # extra fields for the dashboard


def probe_codec(path):
    try:
        return subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=codec_name",
                               "-of", "csv=p=0", path], capture_output=True, text=True, timeout=30).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def probe_duration(path):
    try:
        return float(subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0",
                                     path], capture_output=True, text=True, timeout=30).stdout.strip() or 0)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 0.0


LEN_PREFIX = re.compile(r"/\[\d+s\] ")         # clip length in front of the name on Drive


def status(state, message):
    fd, tmp = tempfile.mkstemp(prefix=".upload.", dir=RUN)   # fresh file: never blocked by an old one
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump({"state": state, "message": message, "time": int(time.time()), **INFO}, f, ensure_ascii=False)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(RUN, "upload.json"))


def main():
    g, cams = cctvconf.load()
    now = time.time()
    pre, post = float(g["pre_capture_sec"]), float(g["post_capture_sec"])
    keep = float(g["motion_only_keep_minutes"]) * 60
    days = [(datetime.now() - timedelta(days=i)).strftime("%Y-%m-%d") for i in (1, 0)]
    root = os.path.realpath(REC)

    to_upload, pruned, secs = [], 0, {}
    for c in cams:
        if not c["enabled"] or c["mode"] == "off":
            continue
        for day in days:
            d = os.path.join(cctvrec.cam_dir(root, c["id"]), day)
            evs = cctvrec.read_events(d, now)
            ivs = [(s - pre, (e + post) if e is not None else None) for s, e, _ in evs]
            for s in cctvrec.segments(d, day, now):     # full-quality segments only
                if not s["done"] or s["merged"]:        # joined 15-min files never go to Drive
                    continue
                if cctvrec.overlaps(s["start"], s["end"], ivs):
                    rel = os.path.relpath(s["path"], root)
                    to_upload.append(rel)
                    # only the part with motion (plus the pre/post seconds) goes to Drive
                    hits = [(max(a, s["start"]), min(b if b is not None else s["end"], s["end"])) for a, b in ivs
                            if a < s["end"] and (b is None or b > s["start"])]
                    a, b = min(h[0] for h in hits), max(h[1] for h in hits)
                    secs[rel] = (s["start"], s["end"], a, b)
                elif c["mode"] in ("motion", "smart") and now - s["end"] > keep:
                    for p in (s["path"], s["path"][:-4] + ".jpg"):
                        try:
                            os.remove(p)
                        except OSError:
                            pass
                    pruned += 1
            for _, _, pic in evs:                   # motion snapshots
                if pic and os.path.exists(os.path.join(d, pic)):
                    to_upload.append(os.path.relpath(os.path.join(d, pic), root))
    if pruned:
        print(f"cctv-upload: removed {pruned} segment(s) without motion")

    if not cctvconf.yes(g["drive_enabled"]):
        return status("off", "Drive upload is off")
    if not (os.path.exists(RCLONE_CONF) and os.path.getsize(RCLONE_CONF)):
        return status("error", "Google Drive is not connected")
    mpath = os.path.join(RUN, "mode")
    mode = open(mpath).read().strip() if os.path.exists(mpath) else "sd"
    if mode == "ssd" and not cctvconf.yes(g["drive_backup_when_ssd"]):
        return status("idle", "SSD connected, Drive backup off")

    done = set()
    if os.path.exists(STATE):
        with open(STATE) as f:
            done = {ln.strip() for ln in f if ln.strip()}
    todo = [p for p in to_upload if p not in done]

    keep_days = set(days)
    try:
        recent = json.load(open(LOG))
    except (OSError, ValueError):
        recent = []
    INFO.update(pending=len([p for p in todo if p.endswith(".mp4")]),
                on_board=len([p for p in to_upload if p.endswith(".mp4")]), recent=recent[:8])
    names = cctvrec.folder_names()                  # same folder names as on the SSD
    folder_of = lambda cam: names.get(cam, cam)
    remote = g["drive_remote"].rstrip("/")
    rc = lambda *a, t=300: subprocess.run(["rclone", "--config", RCLONE_CONF, *a], capture_output=True, text=True, timeout=t)

    # 1. clips still on Drive under old cam1/cam2 folders move to the camera-name folders (server-side, fast)
    try:
        top = {ln.strip().rstrip("/") for ln in rc("lsf", "--dirs-only", remote + "/", t=120).stdout.splitlines()}
    except subprocess.TimeoutExpired:
        top = set()
    for cid, n in names.items():
        if cid in top and n != cid:
            status("busy", "Moving old Drive folders to camera names…")
            try:
                rc("move", f"{remote}/{cid}", f"{remote}/{n}", "--delete-empty-src-dirs", t=1800)
                rc("rmdir", f"{remote}/{cid}", t=120)
            except subprocess.TimeoutExpired:
                pass
            top.add(n)

    # 2. anything already on Drive (same size) counts as uploaded: nothing is sent twice
    local_size = {}
    for p in todo:
        try:
            local_size[p] = os.path.getsize(os.path.join(root, p))
        except OSError:
            local_size[p] = -1
    for folder in {p.split("/")[0] for p in todo}:
        df = folder_of(folder)
        if df not in top:
            continue
        try:
            out = rc("lsf", "-R", "--files-only", "--format", "ps", "--separator", "|", f"{remote}/{df}", t=300).stdout
        except subprocess.TimeoutExpired:
            continue
        have = {}
        for ln in out.splitlines():
            if "|" in ln:
                rel, size = ln.rsplit("|", 1)
                rel = LEN_PREFIX.sub("/", "/" + rel)[1:]          # "[60s] 10-02-00.mp4" -> "10-02-00.mp4"
                have[rel] = int(size) if size.isdigit() else -2
        for p in todo:
            if p.split("/")[0] == folder and have.get(p.split("/", 1)[1]) == local_size.get(p):
                done.add(p)
    todo = [p for p in todo if p not in done]

    def save_state():
        try:                                    # merge: never drop what another run/rename recorded
            with open(STATE) as f:
                disk = {ln.strip() for ln in f if ln.strip()}
        except OSError:
            disk = set()
        keep = {p for p in done | disk if len(p.split("/")) > 1 and p.split("/")[1] in keep_days}
        with open(STATE + ".tmp", "w") as f:
            f.write("\n".join(sorted(keep)) + "\n")
        os.replace(STATE + ".tmp", STATE)

    save_state()
    if not todo:
        INFO.update(pending=0)
        return status("ok", "Drive has every motion clip")

    # 3. upload in batches of a few clips (+ snapshots); progress saved after each batch, and live
    #    speed/percent from rclone every few seconds, so the dashboard shows it is really moving
    clips = sorted(p for p in todo if p.endswith(".mp4"))
    extras = [p for p in todo if not p.endswith(".mp4")]
    total, sent, BATCH = len(clips), 0, 5
    batches = [clips[i:i + BATCH] for i in range(0, total, BATCH)] or [[]]
    batches[0] = batches[0] + extras
    STAT_RE = re.compile(r"([\d.]+ ?\w*B) / ([\d.]+ ?\w*B), (\d+)%, ([\d.]+ ?\w*B/s)(?:, ETA (\S+))?")

    stage = os.path.join(root, ".upload-stage")

    def prepare(batch):
        """Files for this batch, named as on Drive: '[23s] 10-02-35.mp4'. A minute with only a
        few seconds of motion is cut to those seconds (copied, not re-encoded: same quality,
        hardly any CPU); a minute with motion all through goes as it is (a link, no copy)."""
        shutil.rmtree(stage, ignore_errors=True)
        names = {}
        for p in batch:
            cam, _, rest = p.partition("/")
            day, _, fname = rest.rpartition("/")
            src = os.path.join(root, p)
            ddir = os.path.join(stage, cam, day)
            os.makedirs(ddir, exist_ok=True)
            if not p.endswith(".mp4") or p not in secs:
                os.symlink(src, os.path.join(ddir, fname))
                continue
            s0, s1, a, b = secs[p]
            name = None
            if b - a < 0.85 * (s1 - s0) and b - a >= 1:
                tmp = os.path.join(ddir, ".cut.mp4")
                r = subprocess.run(["nice", "-n", "15", "ffmpeg", "-nostdin", "-loglevel", "error", "-y",
                                    "-ss", f"{a - s0:.2f}", "-i", src, "-t", f"{b - a:.2f}", "-map", "0", "-c", "copy",
                                    "-avoid_negative_ts", "make_zero", "-movflags", "+faststart",
                                    *(["-tag:v", "hvc1"] if probe_codec(src) == "hevc" else []), tmp],
                                   capture_output=True, timeout=120)
                dur = probe_duration(tmp) if r.returncode == 0 and os.path.exists(tmp) else 0
                if dur > 0.5:
                    start = b - dur                          # the cut begins at the keyframe before 'a'
                    name = f"[{int(round(dur))}s] " + time.strftime("%H-%M-%S", time.localtime(start)) + ".mp4"
                    os.replace(tmp, os.path.join(ddir, name))
            if name is None:                                 # whole minute
                name = f"[{int(round(s1 - s0))}s] {fname}"
                os.symlink(src, os.path.join(ddir, name))
            try:
                names[p] = (name, os.path.getsize(os.path.join(ddir, name)))
            except OSError:
                names[p] = (name, 0)
        return names

    def live(extra=""):
        INFO.update(sent=sent, total=total, pending=total - sent)
        status("busy", f"Uploading motion clips: {sent}/{total} done{extra}…")

    for batch in batches:
        live()
        ok = True
        try:
            uploaded_as = prepare(batch)
        except (OSError, subprocess.TimeoutExpired) as e:
            print(f"cctv-upload: preparing failed: {e}")
            shutil.rmtree(stage, ignore_errors=True)
            return status("error", "Could not prepare the clips (disk?)")
        quota = False
        for cam in {p.split("/")[0] for p in batch}:      # Drive folder = camera name
            err_tail = []
            try:
                proc = subprocess.Popen(["nice", "-n", "15", "rclone", "copy", os.path.join(stage, cam) + "/",
                                         f"{remote}/{folder_of(cam)}", "--config", RCLONE_CONF,
                                         "--copy-links", "--no-traverse", "--transfers", "2",
                                         "--bwlimit", g["drive_bwlimit"], "--retries", "2",
                                         "--stats", "5s", "--stats-one-line", "--stats-log-level", "NOTICE"],
                                        stderr=subprocess.PIPE, stdout=subprocess.DEVNULL, text=True)
                start = time.time()
                for line in proc.stderr:
                    m = STAT_RE.search(line)
                    if m:
                        INFO.update(batch_pct=int(m.group(3)), speed=m.group(4), eta=m.group(5))
                        live(f" · {m.group(4)}")
                    elif line.strip():
                        err_tail = (err_tail + [line.strip()])[-3:]
                        low = line.lower()
                        if "quota" in low or "storage limit" in low or "insufficient" in low:
                            quota = True
                    if time.time() - start > 1800:
                        proc.kill()
                rc_code = proc.wait()
            finally:
                pass
            if rc_code != 0:
                print("\n".join(err_tail))
                ok = False
                break
        if not ok and quota:
            # Google account storage is full: cctv-drive-clean frees 2 GB extra on its next run
            try:
                open(os.path.join(RUN, "drive-full"), "w").close()
            except OSError:
                pass
            save_state()
            return status("error", "Google account storage is full: making room on Drive, upload goes on by itself")
        INFO.pop("batch_pct", None)
        if not ok:
            save_state()
            return status("error", f"Upload stopped at {sent}/{total}: check internet / Drive (retries every minute)")
        shutil.rmtree(stage, ignore_errors=True)
        done |= set(batch)
        sent += sum(1 for p in batch if p.endswith(".mp4"))
        save_state()
        for p in batch:
            if p.endswith(".mp4"):
                cam, day, f = (p.split("/") + ["", ""])[:3]
                recent.insert(0, {"cam": folder_of(cam), "day": day, "file": uploaded_as.get(p, (f,))[0],
                                  "size": uploaded_as[p][1] if p in uploaded_as else max(0, local_size.get(p, 0)),
                                  "t": int(time.time())})
        recent = recent[:20]
        try:
            with open(LOG + ".tmp", "w") as f:
                json.dump(recent, f)
            os.replace(LOG + ".tmp", LOG)
        except OSError:
            pass
        INFO.update(sent=sent, total=total, pending=total - sent, recent=recent[:8])
    status("ok", f"Uploaded {sent} motion clip(s)")

if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # noqa: BLE001
        print("cctv-upload:", e)
        try:
            status("error", f"Upload error: {e}")
        except OSError as e2:
            print("cctv-upload: cannot write status:", e2)
        sys.exit(1)
