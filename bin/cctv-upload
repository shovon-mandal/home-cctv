#!/usr/bin/env python3
"""Every minute (user cctv):
 1. cameras in "motion" mode: delete finished segments without motion (after a few minutes)
 2. upload every finished segment that overlaps a motion event (plus its motion snapshot)
    to Google Drive, once each. Even the smallest motion counts.
"""
import json
import os
import subprocess
import sys
import tempfile
import time
from datetime import datetime, timedelta

sys.path.insert(0, "/opt/cctv/lib")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import cctvconf  # noqa: E402
import cctvrec  # noqa: E402

RUN = os.environ.get("CCTV_RUN", "/run/cctv")
REC = os.environ.get("CCTV_REC", "/srv/cctv/rec")
RCLONE_CONF = os.environ.get("RCLONE_CONF", "/etc/cctv/rclone.conf")
STATE = os.environ.get("CCTV_UPLOADED", "/srv/cctv/uploaded.txt")


def status(state, en, bn):
    fd, tmp = tempfile.mkstemp(prefix=".upload.", dir=RUN)   # fresh file: never blocked by an old one
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump({"state": state, "message": f"{en} || {bn}", "time": int(time.time())}, f, ensure_ascii=False)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(RUN, "upload.json"))


def main():
    g, cams = cctvconf.load()
    now = time.time()
    pre, post = float(g["pre_capture_sec"]), float(g["post_capture_sec"])
    keep = float(g["motion_only_keep_minutes"]) * 60
    days = [(datetime.now() - timedelta(days=i)).strftime("%Y-%m-%d") for i in (1, 0)]
    root = os.path.realpath(REC)

    to_upload, pruned = [], 0
    for c in cams:
        if not c["enabled"] or c["mode"] == "off":
            continue
        for day in days:
            d = os.path.join(root, c["id"], day)
            evs = cctvrec.read_events(d, now)
            ivs = [(s - pre, (e + post) if e is not None else None) for s, e, _ in evs]
            for s in cctvrec.segments(d, day, now):     # full-quality segments only
                if not s["done"]:
                    continue
                if cctvrec.overlaps(s["start"], s["end"], ivs):
                    to_upload.append(os.path.relpath(s["path"], root))
                elif c["mode"] in ("motion", "smart") and now - s["end"] > keep:
                    for p in (s["path"], s["path"][:-4] + ".jpg"):
                        try:
                            os.remove(p)
                        except OSError:
                            pass
                    pruned += 1
            for _, _, pic in evs:                   # motion snapshots
                if pic and os.path.exists(os.path.join(d, pic)):
                    to_upload.append(os.path.relpath(os.path.join(d, pic), root))
    if pruned:
        print(f"cctv-upload: removed {pruned} segment(s) without motion")

    if not cctvconf.yes(g["drive_enabled"]):
        return status("off", "Drive upload is off", "Drive upload বন্ধ")
    if not (os.path.exists(RCLONE_CONF) and os.path.getsize(RCLONE_CONF)):
        return status("error", "Google Drive is not connected", "Google Drive connect করা হয়নি")
    mpath = os.path.join(RUN, "mode")
    mode = open(mpath).read().strip() if os.path.exists(mpath) else "sd"
    if mode == "ssd" and not cctvconf.yes(g["drive_backup_when_ssd"]):
        return status("idle", "SSD connected, Drive backup off", "SSD চালু, Drive backup বন্ধ")

    done = set()
    if os.path.exists(STATE):
        with open(STATE) as f:
            done = {ln.strip() for ln in f if ln.strip()}
    todo = [p for p in to_upload if p not in done]
    if not todo:
        return status("ok", "Drive has every motion clip", "Drive-এ সব motion clip আছে")

    nclips = sum(1 for p in todo if p.endswith(".mp4"))
    status("busy", f"Uploading {nclips} motion clip(s)…", f"{nclips}টা motion clip upload হচ্ছে…")
    with tempfile.NamedTemporaryFile("w", delete=False, suffix=".txt") as lst:
        lst.write("\n".join(todo) + "\n")
    try:
        r = subprocess.run(["nice", "-n", "15", "rclone", "copy", root + "/", g["drive_remote"],
                            "--config", RCLONE_CONF, "--files-from", lst.name, "--no-traverse",
                            "--transfers", "2", "--bwlimit", g["drive_bwlimit"], "--retries", "2"],
                           capture_output=True, text=True, timeout=3600)
    finally:
        os.unlink(lst.name)
    if r.returncode != 0:
        print(r.stderr[-800:])
        return status("error", "Upload failed: check internet / Drive", "Upload ব্যর্থ: internet বা Drive দেখুন")

    keep_days = set(days)
    done = {p for p in done | set(todo) if len(p.split("/")) > 1 and p.split("/")[1] in keep_days}
    with open(STATE + ".tmp", "w") as f:
        f.write("\n".join(sorted(done)) + "\n")
    os.replace(STATE + ".tmp", STATE)
    n = sum(1 for p in todo if p.endswith(".mp4"))
    status("ok", f"Uploaded {n} motion clip(s)", f"{n}টা motion clip upload হয়েছে")


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # noqa: BLE001
        print("cctv-upload:", e)
        try:
            status("error", f"Upload error: {e}", f"Upload সমস্যা: {e}")
        except OSError as e2:
            print("cctv-upload: cannot write status:", e2)
        sys.exit(1)
