#!/usr/bin/env python3
"""Manage dashboard accounts.

  sudo cctv-user list
  sudo cctv-user add NAME --admin
  sudo cctv-user add NAME --viewer [--cams cam1,cam3] [--no-recordings]
  sudo cctv-user passwd NAME
  sudo cctv-user del NAME
"""
import argparse
import getpass
import os
import sys

sys.path.insert(0, "/opt/cctv/lib")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
import cctvusers  # noqa: E402


def ask_password():
    while True:
        a = getpass.getpass("Password: ")
        b = getpass.getpass("Password again: ")
        if a != b:
            print("Passwords do not match, try again.")
        elif len(a) < 8:
            print("Use at least 8 characters.")
        else:
            return a


def fix_owner():
    try:
        import pwd
        import grp
        os.chown(cctvusers.USERS_PATH, pwd.getpwnam("cctv").pw_uid, grp.getgrnam("cctv").gr_gid)
    except (KeyError, PermissionError, FileNotFoundError):
        pass


def main():
    ap = argparse.ArgumentParser(description="CCTV dashboard users")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    a = sub.add_parser("add")
    a.add_argument("name")
    g = a.add_mutually_exclusive_group()
    g.add_argument("--admin", action="store_true")
    g.add_argument("--viewer", action="store_true")
    a.add_argument("--cams", help="for viewers, e.g. cam1,cam3 (default: all)")
    a.add_argument("--no-recordings", action="store_true", help="viewer cannot open recordings")
    a.add_argument("--ptz", action="store_true", help="viewer may move PTZ cameras")
    a.add_argument("--password", help=argparse.SUPPRESS)
    p = sub.add_parser("passwd")
    p.add_argument("name")
    d = sub.add_parser("del")
    d.add_argument("name")
    args = ap.parse_args()

    data = cctvusers.load()
    try:
        if args.cmd == "list":
            if not data["users"]:
                print("No users. Create one: sudo cctv-user add admin --admin")
            for n, u in sorted(data["users"].items()):
                cams = "all" if u.get("cameras") == "*" else ",".join(u.get("cameras", []))
                rec = "yes" if u.get("recordings") else "no"
                print(f"  {n:16} {u['role']:7} cameras: {cams:20} recordings: {rec}  ptz: {'yes' if u.get('ptz') or u['role']=='admin' else 'no'}")
            return 0
        if args.cmd == "add":
            existing = data["users"].get(args.name)
            pw = args.password or (None if existing else ask_password())
            role = "admin" if args.admin else "viewer" if args.viewer else (existing or {}).get("role", "viewer")
            cams = args.cams.split(",") if args.cams else (existing or {}).get("cameras", "*")
            cctvusers.set_user(data, args.name, pw, role, cams, not args.no_recordings,
                               True if args.ptz else (existing or {}).get("ptz", False))
            cctvusers.save(data)
            print(f"OK: {args.name} ({role})")
        elif args.cmd == "passwd":
            u = data["users"].get(args.name)
            if not u:
                print("No such user")
                return 1
            cctvusers.set_user(data, args.name, ask_password(), u["role"], u.get("cameras"), u.get("recordings"), u.get("ptz"))
            cctvusers.save(data)
            print("Password changed (old logins are signed out)")
        elif args.cmd == "del":
            cctvusers.delete_user(data, args.name)
            cctvusers.save(data)
            print(f"{args.name} deleted")
    except ValueError as e:
        print(f"Error: {str(e).replace(' || ', ' / ')}")
        return 1
    fix_owner()
    return 0


if __name__ == "__main__":
    sys.exit(main())
