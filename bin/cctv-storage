#!/bin/bash
# Storage switcher + cleanup. Runs as root every minute (cctv-storage.timer).
#
#  USB SSD / disk plugged in -> it is mounted automatically and recordings go to <SSD>/CCTV
#  nothing plugged in         -> recordings go to a capped buffer on the SD card
#
# Nothing to set up: plug the SSD in and within a minute a "CCTV" folder appears on it.
# The SSD is NOT formatted: your own files on it are left alone. Only clips inside
# the CCTV folder are ever deleted (when that folder hits ssd_max_gb or the disk gets
# nearly full). Unplug only after: sudo cctv-ssd-eject
# (cctv-ssd-setup can pin one particular disk if several USB disks are plugged in.)
#
# Motion writes into /srv/cctv/rec, which is a symlink we flip between the two.
set -u
CCTV_ROOT=${CCTV_ROOT:-/srv/cctv}
SSD_MNT=${SSD_MNT:-/mnt/cctv-ssd}
RUN=${CCTV_RUN:-/run/cctv}
SSD_ENV=${CCTV_SSD_ENV:-/etc/cctv/ssd.env}
LINK="$CCTV_ROOT/rec"
BUF="$CCTV_ROOT/sd-buffer"
FOLDER="CCTV"
OLD_FOLDER="CCTV-Recordings"          # name used by older versions
CONFIG_CMD=${CCTV_CONFIG_CMD:-/opt/cctv/bin/cctv-config}

eval "$($CONFIG_CMD)" || { echo "config error"; exit 1; }
SSD_UUID=""; SSD_FSTYPE=""
[ -f "$SSD_ENV" ] && . "$SSD_ENV"

mkdir -p "$RUN" "$BUF" "$SSD_MNT"
exec 9>"$RUN/storage.lock"
flock -n 9 || exit 0

log() { echo "cctv-storage: $*"; }
yes_cfg() { case "${1,,}" in yes|on|true|1) return 0;; esac; return 1; }
once() {  # log a message only when it changes (the script runs every minute)
  local f="$RUN/msg-$1"; [ "$(cat "$f" 2>/dev/null)" = "$2" ] && return 0
  echo "$2" > "$f"; log "$2"
}

# Largest USB partition with a filesystem we can write (never the system disk).
detect_usb() {
  lsblk -J -b -o PATH,TRAN,TYPE,FSTYPE,SIZE,UUID,MOUNTPOINT 2>/dev/null | python3 -c '
import json, sys, subprocess
mnt = sys.argv[1]
root = subprocess.run(["findmnt", "-no", "SOURCE", "/"], capture_output=True, text=True).stdout.strip()
ok = {"ext4", "ext3", "ext2", "exfat", "ntfs", "vfat", "xfs", "btrfs"}
best = None
for disk in json.load(sys.stdin).get("blockdevices", []):
    if disk.get("tran") != "usb":
        continue
    parts = disk.get("children") or [disk]
    if any(p.get("path") == root for p in parts) or disk.get("path") == root:
        continue
    for p in parts:
        if p.get("fstype") in ok and p.get("mountpoint") in (None, "", mnt):
            if best is None or int(p.get("size") or 0) > int(best.get("size") or 0):
                best = p
if best:
    print(best["path"], best["uuid"], best["fstype"])
' "$SSD_MNT"
}

DEV=""
if [ -n "${CCTV_TEST_DEV:-}" ]; then
  DEV="$CCTV_TEST_DEV"
elif mountpoint -q "$SSD_MNT"; then
  DEV=$(findmnt -no SOURCE "$SSD_MNT")             # keep using what is mounted (unplug check below)
elif [ -n "$SSD_UUID" ] && [ -e "/dev/disk/by-uuid/$SSD_UUID" ]; then
  DEV="/dev/disk/by-uuid/$SSD_UUID"                 # disk pinned with cctv-ssd-setup
elif yes_cfg "$CFG_SSD_AUTO"; then
  read -r AUTO_PATH AUTO_UUID AUTO_FS < <(detect_usb) || true
  if [ -n "${AUTO_PATH:-}" ]; then
    DEV="$AUTO_PATH"; SSD_FSTYPE="$AUTO_FS"
  elif lsblk -dno TRAN 2>/dev/null | grep -q usb; then
    once "nousable" "USB disk found but no partition with exFAT/NTFS/ext4/FAT (or it is mounted somewhere else): $(lsblk -rno PATH,FSTYPE,MOUNTPOINT | grep -E '^/dev/sd' | tr '\n' ';')"
  fi
fi
[ -z "$DEV" ] && rm -f "$RUN/ejected"               # nothing plugged in -> next SSD is used again

mount_ssd() {  # mount $DEV with options that suit its filesystem
  local u g; u=$(id -u cctv 2>/dev/null || echo 0); g=$(id -g cctv 2>/dev/null || echo 0)
  local own="uid=$u,gid=$g,umask=0022,noatime"
  case "$SSD_FSTYPE" in
    exfat)      mount -t exfat -o "$own" "$DEV" "$SSD_MNT" ;;
    vfat)       mount -t vfat  -o "$own" "$DEV" "$SSD_MNT" ;;
    ntfs|ntfs3) mount -t ntfs3 -o "$own" "$DEV" "$SSD_MNT" 2>/dev/null \
                  || mount -t ntfs3 -o "$own,force" "$DEV" "$SSD_MNT" 2>/dev/null \
                  || mount -t ntfs-3g -o "$own,big_writes" "$DEV" "$SSD_MNT" ;;
    *)          mount -o noatime "$DEV" "$SSD_MNT" ;;
  esac
}

ssd_healthy() {
  [ -n "${CCTV_TEST_SSD_DIR:-}" ] && { [ -f "$SSD_MNT/$FOLDER/.cctv-ssd" ]; return; }
  mountpoint -q "$SSD_MNT" || return 1
  [ -f "$SSD_MNT/$FOLDER/.cctv-ssd" ] || return 1
  touch "$SSD_MNT/$FOLDER/.probe" 2>/dev/null && rm -f "$SSD_MNT/$FOLDER/.probe"
}

# ---- 1. mount / unmount the SSD -------------------------------------------
if [ -z "${CCTV_TEST_SSD_DIR:-}" ] && [ -n "$DEV" ]; then
  if [ -e "$DEV" ] && [ ! -f "$RUN/ejected" ]; then
    if ! mountpoint -q "$SSD_MNT"; then
      if MOUNT_ERR=$(mount_ssd 2>&1); then
        rm -f "$RUN/msg-mountfail"
        log "SSD mounted at $SSD_MNT ($SSD_FSTYPE)"
        # first time on this disk: make the CCTV folder (older versions used CCTV-Recordings)
        if [ ! -d "$SSD_MNT/$FOLDER" ] && [ -d "$SSD_MNT/$OLD_FOLDER" ]; then
          mv "$SSD_MNT/$OLD_FOLDER" "$SSD_MNT/$FOLDER" && log "renamed $OLD_FOLDER -> $FOLDER"
        fi
        mkdir -p "$SSD_MNT/$FOLDER" && touch "$SSD_MNT/$FOLDER/.cctv-ssd"
        chown cctv:cctv "$SSD_MNT/$FOLDER" "$SSD_MNT/$FOLDER/.cctv-ssd" 2>/dev/null
      else
        once "mountfail" "SSD $DEV ($SSD_FSTYPE) found but mount failed: ${MOUNT_ERR:-unknown error}"
      fi
    fi
  else
    [ -e "$DEV" ] || rm -f "$RUN/ejected"          # unplugged -> clear eject flag
    # unplugged without eject: drop the dead mount (an eject unmounts by itself, cleanly)
    if mountpoint -q "$SSD_MNT" && [ ! -e "$DEV" ]; then
      log "SSD gone, lazy-unmounting"
      umount -l "$SSD_MNT" 2>/dev/null
    fi
  fi
  # plugged but broken (I/O errors after a yank): drop it
  if mountpoint -q "$SSD_MNT" && ! ssd_healthy; then
    log "SSD not writable, unmounting"
    umount -l "$SSD_MNT" 2>/dev/null
  fi
fi

# ---- 2. choose target and flip the symlink --------------------------------
if ssd_healthy && [ ! -f "$RUN/ejected" ]; then
  MODE=ssd; TARGET="$SSD_MNT/$FOLDER"
else
  MODE=sd;  TARGET="$BUF"
fi
mkdir -p "$TARGET"
chown cctv:cctv "$TARGET" 2>/dev/null

CUR=$(readlink "$LINK" 2>/dev/null || true)
if [ "$CUR" != "$TARGET" ]; then
  [ -e "$LINK" ] && [ ! -L "$LINK" ] && mv "$LINK" "$LINK.old.$(date +%s)"
  ln -sfn "$TARGET" "$LINK.new" && mv -T "$LINK.new" "$LINK"
  chown -h cctv:cctv "$LINK" 2>/dev/null
  log "recording target -> $MODE ($TARGET)"
fi

# ---- 3. SSD connected: move everything from the SD card onto it, empty the SD card
if [ "$MODE" = ssd ] && [ -n "$(ls -A "$BUF" 2>/dev/null)" ]; then
  ${CCTV_MOVE_CMD:-/opt/cctv/bin/cctv-move} "$BUF" "$TARGET"
  chown -R cctv:cctv "$TARGET" 2>/dev/null
fi

# ---- 4. cleanup: delete oldest clips when space runs low ------------------
# free_bytes DIR NEED : delete old segments until NEED bytes are free (no-motion ones first)
free_bytes() {
  [ "$2" -gt 0 ] 2>/dev/null || return 0
  ${CCTV_CLEAN_CMD:-/opt/cctv/bin/cctv-clean} "$1" "$2"
}

if [ "$MODE" = ssd ]; then
  # a) our folder must stay under ssd_max_gb (your other files are never touched)
  SSDCAP=$(awk -v g="$CFG_SSD_MAX_GB" 'BEGIN{printf "%d", g*1024*1024*1024}')
  if [ "$SSDCAP" -gt 0 ]; then
    used_by_us=$(du -sb "$TARGET" | cut -f1)
    free_bytes "$TARGET" $(( used_by_us - SSDCAP ))
  fi
  # b) the disk must keep ssd_min_free_percent free
  read -r total avail < <(df --output=size,avail -B1 "$TARGET" | tail -1)
  want=$(( total * CFG_SSD_MIN_FREE_PERCENT / 100 ))
  free_bytes "$TARGET" $(( want - avail ))
fi
# SD buffer cap is enforced in both modes (it should be ~empty in SSD mode)
CAP=$(awk -v g="$CFG_SD_BUFFER_GB" 'BEGIN{printf "%d", g*1024*1024*1024}')
MINFREE=$(awk -v g="$CFG_SD_MIN_FREE_GB" 'BEGIN{printf "%d", g*1024*1024*1024}')
size=$(du -sb "$BUF" | cut -f1)
free=$(df --output=avail -B1 "$BUF" | tail -1 | tr -dc 0-9)
over=$(( size - CAP )); short=$(( MINFREE - free ))
free_bytes "$BUF" $(( over > short ? over : short ))

# ---- 5. status for the web UI ---------------------------------------------
read -r total used avail < <(df --output=size,used,avail -B1 "$TARGET" | tail -1)
bufsize=$(du -sb "$BUF" | cut -f1)
cat > "$RUN/storage.json.tmp" <<EOF
{"mode":"$MODE","target":"$TARGET","ejected":$([ -f "$RUN/ejected" ] && echo true || echo false),"ssd_present":$([ -n "$DEV" ] && [ -e "$DEV" ] && echo true || echo false),"rec_bytes":$(du -sb "$TARGET" | cut -f1),"ssd_cap":${SSDCAP:-0},"total":$total,"used":$used,"avail":$avail,"sd_buffer_bytes":$bufsize,"sd_buffer_cap":$CAP,"updated":$(date +%s)}
EOF
mv "$RUN/storage.json.tmp" "$RUN/storage.json"
echo "$MODE" > "$RUN/mode"
chmod 644 "$RUN/storage.json" "$RUN/mode"
