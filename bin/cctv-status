#!/bin/bash
# Quick health check.
echo "== Services =="
for s in cctv-go2rtc cctv-motion cctv-web cctv-storage.timer cctv-upload.timer cctv-drive-clean.timer cctv-apply.path cctv-update.timer cctv-watchdog.timer; do
  printf '  %-24s %s\n' "$s" "$(systemctl is-active "$s")"
done
printf '  %-24s %s\n' cctv-recorder "$(systemctl is-active cctv-recorder)"
echo "== Network =="
dev=$(ip route show default 2>/dev/null | awk '{print $5; exit}')
echo "  internet via: ${dev:-NONE}   $(ip route show default 2>/dev/null | awk '{print "gateway " $3; exit}')"
ip -br -4 addr 2>/dev/null | grep -v '^lo' | grep -v '^tailscale' | sed 's/^/  /'
for w in $(ls /sys/class/net 2>/dev/null | grep -E '^wl'); do
  if command -v iw >/dev/null; then
    iw dev "$w" link 2>/dev/null | grep -E 'SSID|signal|tx bitrate' | sed "s/^\s*/  $w /"
  fi
done
python3 - <<'PY'
import socket, subprocess, sys
sys.path.insert(0, "/opt/cctv/lib")
try:
    import cctvconf
    cams = cctvconf.load()[1]
except Exception as e:
    cams = []; print("  (cannot read cameras:", e, ")")
for c in cams:
    h = c.get("host") or ""
    if not h:
        continue
    try:
        ping = subprocess.run(["ping", "-c", "2", "-W", "2", h], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        ping = subprocess.CompletedProcess([], 1, "", "")
    loss = next((x for x in ping.stdout.splitlines() if "packet loss" in x), "no reply").split(",")[2:3]
    rtt = next((x.split("=")[1].split("/")[1] + " ms" for x in ping.stdout.splitlines() if "rtt" in x or "round-trip" in x), "-")
    try:
        socket.create_connection((h, int(c.get("port") or 554)), 3).close(); rtsp = "RTSP port open"
    except OSError as e:
        rtsp = f"RTSP port CLOSED ({e.__class__.__name__})"
    print(f"  {c['name']} ({h}): ping {'OK ' + rtt if ping.returncode == 0 else 'FAILED'}{(',' + loss[0]) if loss else ''} · {rtsp}")
PY
echo "== Recording =="
python3 -c '
import json, sys
sys.path.insert(0, "/opt/cctv/lib")
try:
    import cctvconf
    names = {c["id"]: c["name"] for c in cctvconf.load()[1]}
except Exception:
    names = {}
d = json.load(open("/run/cctv/recorder.json"))
for k, v in sorted(d.items()):
    if k.startswith("cam"):
        cid, _, low = k.partition(":")
        k = names.get(cid, cid) + (" (low)" if low else "")
        state = "recording" if v.get("recording") else "NOT recording"
        extra = " ".join(x for x in (v.get("codec") or "", "+audio" if v.get("audio") else "", v.get("error") or "") if x)
        print("  " + k + ": " + state + "  " + extra)
' 2>/dev/null || echo "  (no recorder status yet)"
echo "== Storage =="
cat /run/cctv/storage.json 2>/dev/null | python3 -c '
import json,sys
d=json.load(sys.stdin); gb=lambda b: f"{b/1024**3:.1f} GB"
print("  mode:", "SSD" if d["mode"]=="ssd" else "SD card buffer")
print("  free:", gb(d["avail"]), "of", gb(d["total"]))
print("  SD buffer:", gb(d["sd_buffer_bytes"]), "/", gb(d["sd_buffer_cap"]))' || echo "  (no status yet)"
echo "  USB disks seen:"
lsblk -o NAME,TRAN,FSTYPE,SIZE,MOUNTPOINT -e 7 | awk 'NR==1 || /usb/ || /^[^a-z]*sd/' | sed 's/^/    /'
echo "  last storage messages:"
journalctl -u cctv-storage -n 6 --no-pager -o cat 2>/dev/null | grep -v "^$" | sed 's/^/    /' | tail -6
echo "== Version =="
git -C /opt/cctv-src log -1 --format='  %h  %cd  %s' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null | cut -c1-100
cat /run/cctv/update.json 2>/dev/null | sed 's/^/  /'
echo "== Drive =="
cat /run/cctv/upload.json 2>/dev/null || echo "  (no upload yet)"
echo
echo "  last upload run:"
journalctl -u cctv-upload -n 6 --no-pager -o cat 2>/dev/null | sed 's/^/    /'
echo "  files: $(stat -c '%n %U:%G %a' /etc/cctv/cctv.conf /etc/cctv/cameras.conf /etc/cctv/rclone.conf 2>/dev/null | tr '\n' ';')"
echo "== Load =="
uptime
t=$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1); [ -n "$t" ] && echo "  CPU temperature: $((t/1000))°C"
free -h | head -2
echo
echo "Logs: journalctl -u cctv-recorder -n 30   |   journalctl -u cctv-motion -n 30   |   journalctl -u cctv-go2rtc -n 30"
