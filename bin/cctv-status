#!/bin/bash
# Quick health check.
echo "== Services =="
for s in cctv-go2rtc cctv-motion cctv-web cctv-storage.timer cctv-upload.timer cctv-drive-clean.timer cctv-apply.path cctv-update.timer; do
  printf '  %-24s %s\n' "$s" "$(systemctl is-active "$s")"
done
printf '  %-24s %s\n' cctv-recorder "$(systemctl is-active cctv-recorder)"
echo "== Recording =="
python3 -c '
import json
d = json.load(open("/run/cctv/recorder.json"))
for k, v in sorted(d.items()):
    if k.startswith("cam"):
        state = "recording" if v.get("recording") else "NOT recording"
        extra = " ".join(x for x in (v.get("codec") or "", "+audio" if v.get("audio") else "", v.get("error") or "") if x)
        print("  " + k + ": " + state + "  " + extra)
' 2>/dev/null || echo "  (no recorder status yet)"
echo "== Storage =="
cat /run/cctv/storage.json 2>/dev/null | python3 -c '
import json,sys
d=json.load(sys.stdin); gb=lambda b: f"{b/1024**3:.1f} GB"
print("  mode:", "SSD" if d["mode"]=="ssd" else "SD card buffer")
print("  free:", gb(d["avail"]), "of", gb(d["total"]))
print("  SD buffer:", gb(d["sd_buffer_bytes"]), "/", gb(d["sd_buffer_cap"]))' || echo "  (no status yet)"
echo "  USB disks seen:"
lsblk -o NAME,TRAN,FSTYPE,SIZE,MOUNTPOINT -e 7 | awk 'NR==1 || /usb/ || /^[^a-z]*sd/' | sed 's/^/    /'
echo "  last storage messages:"
journalctl -u cctv-storage -n 6 --no-pager -o cat 2>/dev/null | grep -v "^$" | sed 's/^/    /' | tail -6
echo "== Version =="
git -C /opt/cctv-src log -1 --format='  %h  %cd  %s' --date=format:'%Y-%m-%d %H:%M' 2>/dev/null | cut -c1-100
cat /run/cctv/update.json 2>/dev/null | sed 's/^/  /'
echo "== Drive =="
cat /run/cctv/upload.json 2>/dev/null || echo "  (no upload yet)"
echo
echo "== Load =="
uptime
free -h | head -2
echo
echo "Logs: journalctl -u cctv-recorder -n 30   |   journalctl -u cctv-motion -n 30   |   journalctl -u cctv-go2rtc -n 30"
