#!/bin/bash
# Keep a small board's power draw steady.
#   cpu_max_mhz = auto  -> on an Asus Tinker Board: at most 1416 MHz (instead of 1800);
#                          the CPU then needs a lower voltage and far less current at its
#                          peaks, which a phone charger / thin USB cable can keep up with.
#                          Recording copies the video, so it does not need the top speed.
#   cpu_max_mhz = 1200  -> any number: at most that many MHz
#   cpu_max_mhz = 0     -> no limit
# Runs at boot (cctv-power.service) and after settings are applied.
CONF=${CCTV_CONF:-/etc/cctv/cctv.conf}
want=$(sed -n 's/^[[:space:]]*cpu_max_mhz[[:space:]]*=[[:space:]]*\([A-Za-z0-9]*\).*/\1/p' "$CONF" 2>/dev/null | tail -1)
want=${want:-auto}
model=$( { tr -d '\000' < /proc/device-tree/model; } 2>/dev/null )
if [ "$want" = auto ]; then
  case "$model" in *[Tt]inker*) want=1416 ;; *) want=0 ;; esac
fi
for p in /sys/devices/system/cpu/cpu*/cpufreq; do
  [ -w "$p/scaling_max_freq" ] || continue
  max=$(cat "$p/cpuinfo_max_freq")
  if [ "$want" -gt 0 ] 2>/dev/null; then khz=$((want * 1000)); [ "$khz" -lt "$max" ] || khz=$max; else khz=$max; fi
  echo "$khz" > "$p/scaling_max_freq" 2>/dev/null
done
f=/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
[ -r "$f" ] && echo "cctv-power: CPU limit $(( $(cat $f) / 1000 )) MHz${model:+ ($model)}"
exit 0
