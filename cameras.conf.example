# Cameras. Dashboard-এর ⚙️ Settings → Cameras থেকে বদলানো যায়।
# হাতে বদলালে পরে চালান: sudo cctv-apply

[cam1]
name = Imou Ranger 2 Pro
type = imou
host = 192.168.0.100
port = 554
user = admin
password =
main_path = /cam/realmonitor?channel=1&subtype=0
sub_path = /cam/realmonitor?channel=1&subtype=1
mode = motion
record_stream = main
threshold = 250
enabled = no

[cam2]
name = Meari S1 Plus
type = meari
host = 192.168.0.101
port = 554
user = admin
password =
main_path =
sub_path =
mode = motion
record_stream = main
threshold = 250
enabled = no
